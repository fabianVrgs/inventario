# Pooler en modo TRANSACCIÓN (puerto 6543). Es el de producción.
DATABASE_URL=postgresql://postgres.REF:CLAVE@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Pooler en modo SESIÓN (puerto 5432). Sólo para los tests: el modo
# transacción no garantiza que un SET search_path sobreviva entre
# transacciones, y los tests dependen de eso para aislarse por esquema.
DATABASE_URL_TEST=postgresql://postgres.REF:CLAVE@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Obligatoria en Vercel: sin ella req.ip es la IP del proxy para todo el
# mundo, y el limitador por IP se convierte en un bloqueo global.
CONFIAR_EN_PROXY=1
